# Copy to .env and adjust.

# Local default: SQLite (recommended for single-machine / venue use)
USE_SQLITE=true
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend (Vite)
VITE_API_URL=/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Scale mode (~5k concurrent songbook users) ---
# docker compose up -d --build
# USE_SQLITE=false
# POSTGRES_DB=karaoke
# POSTGRES_USER=karaoke
# POSTGRES_PASSWORD=karaoke
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# REDIS_URL=redis://localhost:6379/0
# CONN_MAX_AGE=60
# WEB_CONCURRENCY=4
# PRESENCE_TTL_SECONDS=90
# SONG_LIST_CACHE_TTL=20

# Production tips:
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<strong-random-value>
# DJANGO_ALLOWED_HOSTS=your.domain.com
# CORS_ALLOWED_ORIGINS=https://your.domain.com
# CSRF_TRUSTED_ORIGINS=https://your.domain.com

# Offline Pass (Stripe subscription) — online search stays free
FRONTEND_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# OFFLINE_PASS_LABEL=Offline Pass · ₱149/mo
# OFFLINE_TRIAL_DAYS=3
# ALLOW_LOCAL_TRIAL=false
# EMAIL_INCLUDE_LINK_IN_API=false
# DEFAULT_FROM_EMAIL=Platino Songbook <noreply@yourdomain.com>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# EMAIL_USE_TLS=true
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_OFFLINE_PASS_PRICE=₱149
# VITE_OFFLINE_PASS_LABEL=Offline Pass · ₱149/mo
# VITE_OFFLINE_TRIAL_DAYS=3

# Stripe setup checklist:
# 1) stripe.com → Product "Offline Pass" → Price ₱149 / month → copy price_...
# 2) Developers → API keys → set STRIPE_SECRET_KEY (+ optional publishable)
# 3) Developers → Webhooks → endpoint https://YOUR_DOMAIN/api/billing/webhook/
#    events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed
# 4) Set STRIPE_WEBHOOK_SECRET=whsec_... and STRIPE_PRICE_ID=price_...
# 5) Customer Portal: Settings → Billing → Customer portal (enable cancel/update)
# 6) Payment methods: enable Card (+ GCash if available in PH)
# Trial uses Checkout subscription_data.trial_period_days=3 with payment_method_collection=always
